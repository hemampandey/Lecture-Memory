# Copy to .env for local runs. When deployed, set these as secrets/env vars on your host.

# LLM
OPENAI_API_KEY=
# optional, for OpenAI-compatible providers
OPENAI_BASE_URL=
LLM_MODEL=gpt-4o-mini

# Qdrant Cloud (https://cloud.qdrant.io) — required for deployment
QDRANT_URL=https://<cluster-id>.<region>.cloud.qdrant.io:6333
QDRANT_API_KEY=
QDRANT_COLLECTION=lecture_memory

# Local Docker fallback — only used when QDRANT_URL is empty
QDRANT_HOST=localhost
QDRANT_PORT=6333

# Models
EMBEDDING_MODEL=sentence-transformers/all-MiniLM-L6-v2
WHISPER_MODEL=tiny          # only used when TRANSCRIBE_BACKEND=local

# Transcription: local = openai-whisper on this machine (`uv sync --extra local`)
#                api   = OpenAI-compatible /audio/transcriptions (use this when deployed)
TRANSCRIBE_BACKEND=local
TRANSCRIBE_MODEL=whisper-1  # needs segment timestamps (verbose_json): whisper-1, or whisper-large-v3 on Groq
# Only set these if your LLM provider has no audio API (e.g. GitHub Models); otherwise OPENAI_* is reused
TRANSCRIBE_API_KEY=
# e.g. https://api.openai.com/v1 or https://api.groq.com/openai/v1
TRANSCRIBE_BASE_URL=
TRANSCRIBE_MAX_MB=24        # larger audio is compressed/split with ffmpeg

# YouTube ingestion
YOUTUBE_CAPTIONS=true       # use existing captions first; falls back to audio download
CAPTION_LANGUAGES=en        # comma-separated preference order
# optional http(s) proxy if YouTube blocks your server's IP
YOUTUBE_PROXY_URL=

# UI default for LLM topic tagging (one LLM call per chunk)
USE_LLM_TOPICS=false
